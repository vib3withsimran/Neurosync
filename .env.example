# ── AI provider (check-in questions, hints, explanations) ──
# Any OpenAI-compatible endpoint works. Leave empty to run without AI
# (the app degrades gracefully to basic check-ins).
VITE_AI_API_KEY=
VITE_AI_API_BASE_URL=
VITE_AI_MODEL=

# ── TinyFish (educational resource search & fetch) ──
VITE_TINYFISH_API_KEY=

# ── Supabase (optional: cloud session history) ──
# Leave empty to store session logs locally in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
